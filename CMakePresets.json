{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "config",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "aria_common_DIR": "${sourceDir}/../aria_common/build",
        "GTSAM_DIR": "/Users/mikexyl/Workspaces/deps/lib/cmake/GTSAM",
        "rerun_sdk_DIR": "${sourceDir}/../rerun/install/lib/cmake/rerun_sdk"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build",
      "configurePreset": "config",
      "jobs": 12
    }
  ]
}