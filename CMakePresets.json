{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "config-Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "aria_common_DIR": "${sourceDir}/../aria_common/build",
        "GTSAM_DIR": "${sourceDir}/../gtsam/build/original"
      }
    },
    {
      "name": "config-Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "inherits": "config-Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-Release",
      "configurePreset": "config-Release",
      "jobs": 12
    },
    {
      "name": "build-Debug",
      "configurePreset": "config-Debug",
      "jobs": 12
    }
  ]
}