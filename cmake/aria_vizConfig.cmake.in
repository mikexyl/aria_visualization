# Config.cmake.in
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

#set(rerun_sdk_DIR @rerun_sdk_DIR@)
#find_dependency(rerun_sdk)

# find X11
find_package(X11 REQUIRED)

set(aria_common_DIR @aria_common_DIR@)
find_dependency(aria_common)

# add sfml dependency
find_dependency(SFML COMPONENTS Graphics Window System)

find_package(PkgConfig REQUIRED)
pkg_check_modules(GVC REQUIRED libgvc)

find_package(tgui QUIET)

include("${CMAKE_CURRENT_LIST_DIR}/_deps/tgui-build/tguiTargets.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
